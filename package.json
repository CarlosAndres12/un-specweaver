{
  "name": "un-specweaver",
  "version": "0.1.1",
  "type": "module",
  "description": "Desarrollo dirigido por especificacion: de la idea al codigo en fases verificables, con trazabilidad de requisito a contrato a codigo.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "./start.sh",
    "dev": "./start.sh",
    "dashboard": "node bin/un-specweaver.mjs dashboard",
    "ui": "node bin/un-specweaver.mjs ui",
    "build:ui": "vite build --config src/dashboard/frontend/vite.config.mjs",
    "dev:ui": "vite --config src/dashboard/frontend/vite.config.mjs",
    "test": "node --test \"test/*.mjs\"",
    "bridge": "node bridge/cli.mjs",
    "un-specweaver": "node bin/un-specweaver.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "spec-driven",
    "sdd",
    "agents",
    "ai-agents",
    "bmad",
    "openspec",
    "gentle-ai",
    "claude-code",
    "opencode",
    "workflow"
  ],
  "license": "MIT",
  "bin": {
    "un-specweaver": "bin/un-specweaver.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "bridge/",
    "fixtures/",
    "README.md",
    "LICENSE"
  ],
  "author": "Juan Sebastián Méndez Rondón <jumendezro@unal.edu.co>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deathperminut/un-specweaver.git"
  },
  "bugs": {
    "url": "https://github.com/deathperminut/un-specweaver/issues"
  },
  "homepage": "https://github.com/deathperminut/un-specweaver#readme",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.6",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.2.2"
  }
}
